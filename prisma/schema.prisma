generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Vehicle {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  vehicleType         VehicleType
  /// Engine displacement in cc. Required for Scooter and Motorcycle (50 or 125). Null for Bicycle and ATV.
  engineCc            Int?
  brand               String?
  model               String?
  color               String?
  shortDescription    String?
  description         String?
  mainImageUrl        String?
  isActive            Boolean              @default(true)
  displayOrder        Int                  @default(0)
  helmetIncludedCount Int                  @default(2)
  supportsStorageBox  Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  catalogStatus       VehicleCatalogStatus @default(AVAILABLE)
  licensePlate        String?              @unique
  baseDailyRate       Decimal              @db.Decimal(10, 2)
  availabilityBlocks  AvailabilityBlock[]
  bookings            Booking[]
  reservationHolds    ReservationHold[]
  images              VehicleImage[]
  pricingRules        VehiclePricingRule[]
  units               VehicleUnit[]
  vehicleAssignments  BookingVehicleAssignment[]

  @@index([isActive, displayOrder])
  @@index([vehicleType, isActive])
  @@index([catalogStatus, isActive])
}

model VehicleUnit {
  id               String                 @id @default(cuid())
  vehicleId        String
  licensePlate     String                 @unique
  color            String?
  status           VehicleUnitStatus      @default(AVAILABLE)
  isActive         Boolean                @default(true)
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  bookings         Booking[]
  reservationHolds ReservationHold[]
  vehicle          Vehicle                     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  occupancies      VehicleUnitOccupancy[]
  assignments      BookingVehicleAssignment[]

  @@index([vehicleId, isActive, status])
  @@index([vehicleId, createdAt])
  @@index([vehicleId, color, isActive, status])
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, sortOrder])
  @@index([vehicleId, isPrimary])
}

model DurationPricingRule {
  id              String      @id @default(cuid())
  vehicleType     VehicleType
  minDays         Int
  maxDays         Int?
  discountPercent Decimal     @db.Decimal(5, 2)
  isActive        Boolean     @default(true)
  displayOrder    Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([vehicleType, isActive, displayOrder])
}

model VehiclePricingRule {
  id          String          @id @default(cuid())
  vehicleId   String?
  vehicleType VehicleType?
  ruleType    PricingRuleType
  dailyRate   Decimal         @db.Decimal(10, 2)
  minDays     Int?
  maxDays     Int?
  dayOfWeek   Int?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  vehicle     Vehicle?        @relation(fields: [vehicleId], references: [id])

  @@index([vehicleType, ruleType, isActive])
  @@index([vehicleId, ruleType, isActive])
  @@index([startDate, endDate])
}

model TermsVersion {
  id              String    @id @default(cuid())
  version         String    @unique
  title           String
  summaryText     String?
  fullDocumentUrl String?
  isActive        Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bookings        Booking[]

  @@index([isActive])
}

model AdminUser {
  id            String                 @id @default(cuid())
  name          String
  email         String                 @unique
  passwordHash  String?
  role          AdminRole              @default(STAFF)
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  sessions            AdminSession[]
  statusChanges       BookingStatusHistory[]
  bookingExtensions   BookingExtension[]
  vehicleReplacements BookingVehicleAssignment[]
  initiatedEmails     EmailLog[]
  manualReviewResends BookingReviewRequest[] @relation("BookingReviewRequestManualResend")
  notificationsCreated AdminNotification[]

  @@index([role, isActive])
}

model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model AdminLoginLockout {
  id              String    @id @default(cuid())
  emailNormalized String
  ipAddressHash   String
  failedCount     Int       @default(0)
  firstFailedAt   DateTime?
  lastFailedAt    DateTime?
  lockedUntil     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([emailNormalized, ipAddressHash])
  @@index([updatedAt])
  @@index([lockedUntil])
}

model HotelPartner {
  id                 String                   @id @default(cuid())
  name               String
  contactPerson      String?
  email              String?
  phone              String?
  address            String?
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  bookings           Booking[]
  hotelCodes         HotelCode[]
  monthlySettlements HotelMonthlySettlement[]

  @@index([isActive, name])
}

model HotelMonthlySettlement {
  id                         String                @id @default(cuid())
  hotelPartnerId             String
  month                      Int
  year                       Int
  bookingCountSnapshot       Int
  totalBookingAmountSnapshot Decimal               @db.Decimal(12, 2)
  totalHotelDiscountSnapshot Decimal               @db.Decimal(12, 2)
  settlementAmountDue        Decimal               @db.Decimal(12, 2)
  amountPaid                 Decimal               @default(0) @db.Decimal(12, 2)
  status                     HotelSettlementStatus @default(DUE)
  paidAt                     DateTime?
  notes                      String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  hotelPartner               HotelPartner          @relation(fields: [hotelPartnerId], references: [id])

  @@unique([hotelPartnerId, month, year])
  @@index([year, month])
  @@index([status])
}

model HotelCode {
  id              String       @id @default(cuid())
  code            String       @unique
  hotelPartnerId  String
  discountPercent Decimal      @db.Decimal(5, 2)
  isActive        Boolean      @default(true)
  validFrom       DateTime?
  validUntil      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  bookings        Booking[]
  hotelPartner    HotelPartner @relation(fields: [hotelPartnerId], references: [id])

  @@index([hotelPartnerId, isActive])
  @@index([isActive, code])
}

model Booking {
  id                                         String                  @id @default(cuid())
  bookingReference                           String                  @unique
  status                                     BookingStatus           @default(CONFIRMED)
  createdAt                                  DateTime                @default(now())
  updatedAt                                  DateTime                @updatedAt
  vehicleType                                VehicleType
  pickupDateTime                             DateTime
  returnDateTime                             DateTime
  actualDurationHours                        Decimal                 @db.Decimal(8, 2)
  billableDays                               Int
  pickupOption                               PickupOption
  pickupAddress                              String?
  dropoffOption                              DropoffOption
  dropoffAddress                             String?
  customerFullName                           String
  customerPhone                              String
  customerEmail                              String
  customerNationality                        String
  customerDateOfBirth                        DateTime
  customerLicenseCategory                    LicenseCategory
  customerSpecialNotes                       String?
  customerLicenseUploadPath                  String?
  customerPassportUploadPath                 String?
  customerWillPresentLicenseAtPickup         Boolean                 @default(false)
  customerWillPresentIdAtPickup              Boolean                 @default(false)
  additionalDriverEnabled                    Boolean                 @default(false)
  additionalDriverFullName                   String?
  additionalDriverPhone                      String?
  additionalDriverEmail                      String?
  additionalDriverNationality                String?
  additionalDriverDateOfBirth                DateTime?
  additionalDriverLicenseCategory            LicenseCategory?
  additionalDriverPassportUploadPath         String?
  additionalDriverWillPresentIdAtPickup      Boolean                 @default(false)
  cdwOption                                  CdwOption               @default(NO_CDW)
  cdwDailyRate                               Decimal                 @default(0) @db.Decimal(10, 2)
  cdwTotal                                   Decimal                 @default(0) @db.Decimal(10, 2)
  additionalDriverDailyRate                  Decimal                 @default(0) @db.Decimal(10, 2)
  additionalDriverTotal                      Decimal                 @default(0) @db.Decimal(10, 2)
  storageBoxSelected                         Boolean                 @default(false)
  storageBoxCost                             Decimal                 @default(0) @db.Decimal(10, 2)
  rentalCost                                 Decimal                 @default(0) @db.Decimal(10, 2)
  deliveryFee                                Decimal                 @default(0) @db.Decimal(10, 2)
  dropoffFee                                 Decimal                 @default(0) @db.Decimal(10, 2)
  deliveryTotal                              Decimal                 @default(0) @db.Decimal(10, 2)
  subtotal                                   Decimal                 @default(0) @db.Decimal(10, 2)
  depositAmount                              Decimal                 @default(0) @db.Decimal(10, 2)
  depositMethod                              DepositMethod
  totalDueOnline                             Decimal                 @default(0) @db.Decimal(10, 2)
  totalDueLater                              Decimal                 @default(0) @db.Decimal(10, 2)
  termsAccepted                              Boolean                 @default(false)
  termsAcceptedAt                            DateTime?
  confirmationEmailSentAt                    DateTime?
  confirmationEmailStatus                    ConfirmationEmailStatus @default(NOT_SENT)
  additionalDriverLicenseUploadPath          String?
  consentSource                              String?
  dropoffLatitude                            Decimal?                @db.Decimal(9, 6)
  dropoffLongitude                           Decimal?                @db.Decimal(9, 6)
  pickupLatitude                             Decimal?                @db.Decimal(9, 6)
  pickupLongitude                            Decimal?                @db.Decimal(9, 6)
  termsVersion                               String?
  helmetSize1                                HelmetSize?
  helmetSize2                                HelmetSize?
  additionalDriverWillPresentLicenseAtPickup Boolean                 @default(false)
  vehicleId                                  String?
  vehicleNameSnapshot                        String?
  vehicleTypeSnapshot                        VehicleType?
  termsVersionId                             String?
  vehicleLicensePlateSnapshot                String?
  vehicleColorSnapshot                       String?
  baseDailyRateSnapshot                      Decimal?                @db.Decimal(10, 2)
  durationDiscountPercentSnapshot            Decimal?                @db.Decimal(5, 2)
  appliedDailyRateSnapshot                   Decimal?                @db.Decimal(10, 2)
  hotelCodeId                                String?
  hotelPartnerId                             String?
  hotelCodeSnapshot                          String?
  hotelPartnerNameSnapshot                   String?
  hotelDiscountPercentSnapshot               Decimal?                @db.Decimal(5, 2)
  hotelDiscountAmountSnapshot                Decimal?                @db.Decimal(10, 2)
  subtotalAfterHotelDiscountSnapshot         Decimal?                @db.Decimal(10, 2)
  vehicleUnitId                              String?
  paymentStatus                              PaymentStatus           @default(PENDING)
  securityDepositStatus                      SecurityDepositStatus   @default(PENDING)
  paymentProofUploadPath                     String?
  paymentReceivedAmount                      Decimal?                @db.Decimal(10, 2)
  paymentMethod                              PaymentMethod?
  securityDepositCollectedAmount             Decimal?                @db.Decimal(10, 2)
  handoverDateTime                           DateTime?
  handoverNotes                              String?
  returnRecordedAt                           DateTime?
  returnNotes                                String?
  depositRefundAmount                        Decimal?                @db.Decimal(10, 2)
  depositDeductionAmount                     Decimal?                @db.Decimal(10, 2)
  depositDeductionReason                     String?
  completionNotes                            String?
  idempotencyKey                             String?                 @unique
  /// €5 loyalty discount applied to this booking's charges. Null when none was redeemed.
  /// The security deposit is not included in this amount.
  loyaltyCreditAmount                        Decimal?                @db.Decimal(10, 2)
  hotelCode                                  HotelCode?              @relation(fields: [hotelCodeId], references: [id])
  hotelPartner                               HotelPartner?           @relation(fields: [hotelPartnerId], references: [id])
  acceptedTermsVersion                       TermsVersion?           @relation(fields: [termsVersionId], references: [id])
  vehicle                                    Vehicle?                @relation(fields: [vehicleId], references: [id])
  vehicleUnit                                VehicleUnit?            @relation(fields: [vehicleUnitId], references: [id])
  documents                                  BookingDocument[]
  statusHistory                              BookingStatusHistory[]
  emailLogs                                  EmailLog[]
  reviewRequest                              BookingReviewRequest?
  loyaltyCreditIssued                        CustomerLoyaltyCredit?  @relation("LoyaltyCreditSource")
  loyaltyCreditRedeemed                      CustomerLoyaltyCredit?  @relation("LoyaltyCreditRedemption")
  reservationHolds                           ReservationHold[]
  extensions                                 BookingExtension[]
  StripePayment                              StripePayment?
  unitOccupancies                            VehicleUnitOccupancy[]
  vehicleAssignments                         BookingVehicleAssignment[]
  adminNotifications                         AdminNotification[]

  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([securityDepositStatus])
  @@index([hotelCodeId])
  @@index([hotelPartnerId])
  @@index([pickupDateTime, returnDateTime])
  @@index([vehicleType, pickupDateTime])
  @@index([customerEmail, customerPhone])
  @@index([vehicleId])
  @@index([vehicleUnitId])
  @@index([termsVersionId])
}

/// Shared admin inbox for booking lifecycle events. Read state is shared across admins.
model AdminNotification {
  id               String                @id @default(cuid())
  type             AdminNotificationType
  title            String
  message          String
  bookingId        String?
  bookingReference String?
  metadata         Json?
  isRead           Boolean               @default(false)
  readAt           DateTime?
  createdByAdminId String?
  createdAt        DateTime              @default(now())
  booking          Booking?              @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdByAdmin   AdminUser?            @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([isRead, createdAt])
  @@index([createdAt])
  @@index([bookingId])
  @@index([createdByAdminId])
}

/// Incremental return-date extension. Amounts are the extra charge at the original booking rate.
model BookingExtension {
  id                            String    @id @default(cuid())
  bookingId                     String
  previousReturnDateTime        DateTime
  newReturnDateTime             DateTime
  additionalBillableDays        Int
  appliedDailyRate              Decimal   @db.Decimal(10, 2)
  additionalRentalAmount        Decimal   @db.Decimal(10, 2)
  additionalHotelDiscountAmount Decimal   @default(0) @db.Decimal(10, 2)
  additionalCdwAmount           Decimal   @default(0) @db.Decimal(10, 2)
  additionalDriverAmount        Decimal   @default(0) @db.Decimal(10, 2)
  additionalAmount              Decimal   @db.Decimal(10, 2)
  createdByAdminId              String?
  createdAt                     DateTime  @default(now())
  booking                       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdBy                     AdminUser? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([createdByAdminId])
}

model BookingStatusHistory {
  id               String         @id @default(cuid())
  bookingId        String
  oldStatus        BookingStatus?
  newStatus        BookingStatus
  note             String?
  changedByAdminId String?
  createdAt        DateTime       @default(now())
  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy        AdminUser?     @relation(fields: [changedByAdminId], references: [id])

  @@index([bookingId, createdAt])
  @@index([changedByAdminId])
}

model EmailLog {
  id                String                  @id @default(cuid())
  bookingId         String?
  emailType         EmailType
  recipientEmail    String
  subject           String
  status            ConfirmationEmailStatus
  providerMessageId String?
  errorMessage      String?
  sentAt             DateTime?
  failedAt           DateTime?
  createdAt          DateTime                @default(now())
  initiatedByAdminId String?
  booking            Booking?                @relation(fields: [bookingId], references: [id])
  initiatedBy        AdminUser?              @relation(fields: [initiatedByAdminId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([recipientEmail, createdAt])
  @@index([status, createdAt])
  @@index([initiatedByAdminId])
}

/// One €5 next-rental credit earned by a returned booking.
/// Identity is the normalized customer email. There is no customer account.
/// A source booking issues at most one credit. A credit is redeemed by at most one booking.
model CustomerLoyaltyCredit {
  id                      String              @id @default(cuid())
  sourceBookingId         String              @unique
  customerEmailNormalized String
  amount                  Decimal             @db.Decimal(10, 2)
  currency                String              @default("EUR")
  status                  LoyaltyCreditStatus @default(AVAILABLE)
  issuedAt                DateTime            @default(now())
  redeemedAt              DateTime?
  redeemedBookingId       String?             @unique
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  sourceBooking           Booking             @relation("LoyaltyCreditSource", fields: [sourceBookingId], references: [id], onDelete: Cascade)
  redeemedBooking         Booking?            @relation("LoyaltyCreditRedemption", fields: [redeemedBookingId], references: [id], onDelete: Restrict)

  @@index([customerEmailNormalized, status, issuedAt])
}

/// One automatic post-return review request per booking.
/// Delivery runs outside the rental-return transaction.
model BookingReviewRequest {
  id                        String              @id @default(cuid())
  bookingId                 String              @unique
  status                    ReviewRequestStatus
  scheduledAt               DateTime
  sentAt                    DateTime?
  lastSentAt                DateTime?
  attempts                  Int                 @default(0)
  lastError                 String?
  skippedReason             String?
  processingStartedAt       DateTime?
  manualResendCount         Int                 @default(0)
  lastManualResendAt        DateTime?
  lastManualResendByAdminId String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  booking                   Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lastManualResendBy        AdminUser?          @relation("BookingReviewRequestManualResend", fields: [lastManualResendByAdminId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([lastManualResendByAdminId])
}

model AvailabilityBlock {
  id            String                @id @default(cuid())
  vehicleId     String?
  vehicleType   VehicleType?
  blockType     AvailabilityBlockType
  startDateTime DateTime
  endDateTime   DateTime
  reason        String?
  createdAt     DateTime              @default(now())
  vehicle       Vehicle?              @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, startDateTime, endDateTime])
  @@index([vehicleType, startDateTime, endDateTime])
  @@index([blockType, startDateTime])
}

model ReservationHold {
  id              String                @id @default(cuid())
  holdReference   String                @unique
  vehicleId       String
  vehicleType     VehicleType
  sessionKey      String
  customerEmail   String?
  customerName    String?
  pickupDateTime  DateTime
  returnDateTime  DateTime
  status          ReservationHoldStatus @default(ACTIVE)
  reservedAt      DateTime              @default(now())
  expiresAt       DateTime
  lastHeartbeatAt DateTime?
  bookingId       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  vehicleUnitId   String?
  selectedColor   String?
  booking         Booking?              @relation(fields: [bookingId], references: [id])
  vehicle         Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleUnit     VehicleUnit?          @relation(fields: [vehicleUnitId], references: [id])
  unitOccupancy   VehicleUnitOccupancy?

  @@index([vehicleId, status, expiresAt])
  @@index([vehicleUnitId, status, expiresAt])
  @@index([sessionKey, status])
  @@index([expiresAt])
  @@index([pickupDateTime, returnDateTime])
}

model ContactInquiry {
  id        String               @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  subject   String?
  message   String
  status    ContactInquiryStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
}

/// Database-enforced non-overlapping occupancy per physical unit (half-open [pickupAt, returnAt)).
/// One booking may own several rows after a mid-rental replacement: the closed interval on the
/// previous unit, and the remaining interval on the unit now with the customer.
/// The generated `period` column and EXCLUDE constraint are defined in SQL migration.
model VehicleUnitOccupancy {
  id                String                    @id @default(cuid())
  vehicleUnitId     String
  pickupAt          DateTime                  @db.Timestamptz(3)
  returnAt          DateTime                  @db.Timestamptz(3)
  bookingId         String?
  reservationHoldId String?                   @unique
  createdAt         DateTime                  @default(now())
  period            Unsupported("tstzrange")? @default(dbgenerated("tstzrange(\"pickupAt\", \"returnAt\", '[)'::text)"))
  booking           Booking?                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reservationHold   ReservationHold?          @relation(fields: [reservationHoldId], references: [id], onDelete: Cascade)
  vehicleUnit       VehicleUnit               @relation(fields: [vehicleUnitId], references: [id], onDelete: Cascade)

  @@index([vehicleUnitId])
  @@index([bookingId])
  @@index([pickupAt, returnAt])
}

/// Physical vehicles actually handed to the customer on one booking.
/// These rows stay after occupancy locks are released on completion or cancellation.
model BookingVehicleAssignment {
  id                   String             @id @default(cuid())
  bookingId            String
  vehicleId            String?
  vehicleUnitId        String
  vehicleNameSnapshot  String
  licensePlateSnapshot String?
  colorSnapshot        String?
  vehicleTypeSnapshot  VehicleType?
  startedAt            DateTime
  endedAt              DateTime?
  endDisposition       VehicleUnitStatus?
  reason               String?
  note                 String?
  createdByAdminId     String?
  createdAt            DateTime           @default(now())
  booking              Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vehicle              Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  vehicleUnit          VehicleUnit        @relation(fields: [vehicleUnitId], references: [id], onDelete: Restrict)
  createdBy            AdminUser?         @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([bookingId, startedAt])
  @@index([vehicleUnitId])
  @@index([vehicleId])
  @@index([createdByAdminId])
}

model BookingDocument {
  id                String            @id @default(cuid())
  bookingId         String
  documentOwnerType DocumentOwnerType
  documentType      DocumentType
  filePath          String
  publicUrl         String?
  mimeType          String?
  fileSize          Int?
  uploadedAt        DateTime          @default(now())
  booking           Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, documentOwnerType, documentType])
  @@index([uploadedAt])
}

model PaymentAuditLog {
  id              String   @id
  bookingId       String?
  stripePaymentId String?
  action          String
  actor           String
  oldValue        Json?
  newValue        Json?
  ipAddress       String?
  createdAt       DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([createdAt])
  @@index([stripePaymentId, createdAt])
}

model StripePayment {
  id                      String              @id
  bookingId               String              @unique
  stripePaymentIntentId   String?             @unique
  stripeCheckoutSessionId String?             @unique
  amountCents             Int
  /// Rental portion of amountCents. Historical rows: equals amountCents.
  rentalAmountCents       Int
  /// Security-deposit portion of amountCents. Historical rows: 0 (not invented).
  depositAmountCents      Int                 @default(0)
  currency                String              @default("eur")
  stripeStatus            StripePaymentStatus @default(PENDING)
  refundStatus            RefundStatus        @default(NONE)
  /// Combined succeeded (Stripe-reconciled) refund total. Kept for compatibility.
  refundedAmountCents     Int                 @default(0)
  /// Succeeded rental-purpose refunds only. Pending capacity is derived from StripeRefundRequest.
  rentalRefundedCents     Int                 @default(0)
  /// Succeeded deposit-purpose refunds only. Pending capacity is derived from StripeRefundRequest.
  depositRefundedCents    Int                 @default(0)
  metadata                Json?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime
  Booking                 Booking             @relation(fields: [bookingId], references: [id])
  StripeRefund            StripeRefund[]
  StripeRefundRequest     StripeRefundRequest[]
  StripeTransaction       StripeTransaction[]

  @@index([createdAt])
  @@index([stripeStatus])
}

model StripeRefund {
  id              String        @id
  stripePaymentId String
  stripeRefundId  String        @unique
  amountCents     Int
  reason          RefundReason
  status          String
  initiatedBy     String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  StripePayment   StripePayment @relation(fields: [stripePaymentId], references: [id], onDelete: Cascade)

  @@index([stripePaymentId])
}

/// Durable admin refund claim / reservation. Exists before Stripe returns a refund ID.
/// Pending reserved capacity = SUM(amountCents) WHERE status = PENDING (per payment / purpose).
model StripeRefundRequest {
  id              String                    @id
  stripePaymentId String
  /// Stable client idempotency identity. Stripe idempotency key: refund:{paymentId}:{clientRequestId}
  clientRequestId String                    @unique
  purpose         RefundPurpose
  amountCents     Int
  status          StripeRefundRequestStatus @default(PENDING)
  /// Set only when Stripe returns (or webhook delivers) a real refund id. Never fabricate.
  stripeRefundId  String?                   @unique
  initiatedBy     String?
  notes           String?
  metadata        Json?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime
  StripePayment   StripePayment             @relation(fields: [stripePaymentId], references: [id], onDelete: Cascade)

  @@index([stripePaymentId])
  @@index([stripePaymentId, status])
  @@index([stripePaymentId, purpose, status])
}

model StripeTransaction {
  id                  String        @id
  stripePaymentId     String
  transactionType     String
  stripeTransactionId String        @unique
  amountCents         Int
  currency            String        @default("eur")
  status              String
  metadata            Json?
  createdAt           DateTime      @default(now())
  StripePayment       StripePayment @relation(fields: [stripePaymentId], references: [id], onDelete: Cascade)

  @@index([stripePaymentId])
}

/// Stripe webhook delivery record with a lease-based processing claim.
///
/// Compatibility: `processed` remains authoritative-true for completed events and is
/// written together with status PROCESSED. The migration only enforces the one-way
/// rule (status PROCESSED => processed = true) so a rolled-back app that only sets
/// `processed` never violates a constraint; the new app treats `processed = true` as
/// already processed even if `status` was left stale by older code.
model WebhookEvent {
  id              String             @id
  stripeEventId   String             @unique
  eventType       String
  processed       Boolean            @default(false)
  processedAt     DateTime?
  payload         Json
  /// Truncated last error text (legacy column; retained for history).
  error           String?
  createdAt       DateTime           @default(now())
  status          WebhookEventStatus @default(RECEIVED)
  /// Opaque owner token of the current lease; null unless status = PROCESSING.
  claimToken      String?
  /// Lease expiry (UTC, database clock); null unless status = PROCESSING.
  claimExpiresAt  DateTime?
  /// Fencing value; incremented on every successful claim.
  claimGeneration Int                @default(0)
  /// Number of claims acquired (handler attempts started).
  attemptCount    Int                @default(0)
  /// Stable machine-readable code for the last failure (see webhook-errors).
  lastErrorCode   String?
  lastAttemptAt   DateTime?
  /// Stable code explaining why the event is DEAD_LETTER (e.g. RETRY_LIMIT_EXCEEDED,
  /// EVENT_METADATA_MISSING). lastErrorCode/error keep the original failure evidence.
  deadLetterReason String?
  deadLetteredAt  DateTime?

  @@index([createdAt])
  @@index([eventType, processed])
  @@index([stripeEventId])
  @@index([status, claimExpiresAt])
  @@index([status, createdAt])
  @@index([status, lastAttemptAt])
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  RETRYABLE_FAILED
  DEAD_LETTER
}

